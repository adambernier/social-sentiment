# Caddy reverse proxy + automatic HTTPS.
# SITE_ADDRESS and ACME_EMAIL come from the environment (set in .env, passed
# through by the caddy service in docker-compose.yml). With a real hostname in
# SITE_ADDRESS, Caddy provisions a trusted Let's Encrypt cert and redirects
# 80 -> 443 automatically.

{
    email {$ACME_EMAIL}
}

{$SITE_ADDRESS} {
    # API traffic -> FastAPI backend
    @api {
        path /api/*
    }
    reverse_proxy @api api-service:8000

    # Grafana (embedded read-only in the admin dashboard)
    @grafana {
        path /grafana/*
    }
    reverse_proxy @grafana grafana:3000

    # Everything else -> Next.js frontend
    reverse_proxy ui-service:3000
}
