{
  "title": "System Health",
  "uid": "system-health",
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Ingestion Rate (Posts/min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(posts_ingested_total[1m]) * 60",
          "legendFormat": "{{platform}} - {{symbol}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Internal Pipeline Processing Rate (Msgs/min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(messages_processed_total[1m]) * 60",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate Limits Hit",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "increase(rate_limits_hit_total[5m])",
          "legendFormat": "{{platform}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API Request Duration (ms)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(http_request_duration_seconds_sum[1m]) / rate(http_request_duration_seconds_count[1m]) * 1000",
          "legendFormat": "{{method}} {{handler}}",
          "refId": "A"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
