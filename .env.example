# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# To override the default development credentials (e.g. for staging/production),
# copy this file to `.env` in the project root and fill in secure values:
#
#   cp .env.example .env
#
# Do NOT commit `.env` to version control.
# ==============================================================================

# Database Configuration
POSTGRES_DB=sentiment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASS=your_secure_rabbitmq_password_here
