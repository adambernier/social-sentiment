# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# To override the default development credentials (e.g. for staging/production),
# copy this file to `.env` in the project root and fill in secure values:
#
#   cp .env.example .env
#
# Do NOT commit `.env` to version control.
# ==============================================================================

# Database Configuration
POSTGRES_DB=sentiment
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# PostgreSQL physical backups and point-in-time recovery (DigitalOcean Spaces)
# Keep false for local development. Production should use a dedicated private,
# versioned bucket and a runtime key that cannot administer the bucket.
WALG_ENABLED=false
WALG_S3_PREFIX=s3://your-private-backup-space/postgres/production
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_REGION=sfo3
SPACES_WALG_UPLOAD_ACCESS_KEY=
SPACES_WALG_UPLOAD_SECRET_KEY=
WALG_ARCHIVE_TIMEOUT=60s
WALG_COMPRESSION_METHOD=zstd
# Generate once with `openssl rand -base64 32`; loss of this key makes every
# WAL/base-backup object unrecoverable. Store a separately escrowed copy.
WALG_LIBSODIUM_KEY=
WALG_LIBSODIUM_KEY_TRANSFORM=base64

# Do not place maintenance or restore credentials in the long-running Postgres
# container. Load them only for the retention/restore scripts from root-owned
# environment files on the deployment host.
SPACES_WALG_MAINTENANCE_ACCESS_KEY=
SPACES_WALG_MAINTENANCE_SECRET_KEY=
SPACES_WALG_RESTORE_ACCESS_KEY=
SPACES_WALG_RESTORE_SECRET_KEY=
WALG_RETAIN_FULL_BACKUPS=35

# Separate analytical archive prefix/credential. This can live in a colder
# bucket later without changing the physical backup path.
ANALYTICS_S3_PREFIX=s3://your-private-analytics-space/analytics/production
SPACES_ANALYTICS_ACCESS_KEY=
SPACES_ANALYTICS_SECRET_KEY=
# Separate 32-byte SSE-C key, base64 encoded (`openssl rand -base64 32`).
ANALYTICS_SSE_C_KEY_B64=
ANALYTICS_ARCHIVE_PURGE_DAYS=7

# Analytical retention. An empty RAW_ARCHIVE_PLATFORMS value is the privacy-safe
# default: aggregates persist, but no cleaned post text enters archive staging.
POST_RETENTION_DAYS=14
QUOTE_RETENTION_DAYS=90
RAW_ARCHIVE_PLATFORMS=
RAW_ARCHIVE_SAMPLE_RATE=0.01
RAW_ARCHIVE_CHALLENGE_ENGAGEMENT=100
RAW_ARCHIVE_CHALLENGE_ABS_SIGNAL=0.8

# Human-readable model aliases. Analytical identity uses the artifact SHA-256.
TOPIC_MODEL_VERSION=zero-shot-onnx-v1
SENTIMENT_MODEL_VERSION=fintwitbert-onnx-v1
PIPELINE_GIT_COMMIT=unknown

# RabbitMQ Configuration
RABBITMQ_USER=guest
RABBITMQ_PASS=your_secure_rabbitmq_password_here

# HTTPS / Caddy (production on the droplet)
# SITE_ADDRESS is the registered hostname Caddy gets a Let's Encrypt cert for.
# Leave it empty for local dev (Caddy won't start without it; that's expected
# if you don't run the caddy service locally).
SITE_ADDRESS=sentiment.example.com
ACME_EMAIL=you@example.com

# Private DaySmart schedule exporter. Point this hostname at the same droplet.
# Generate the hash with `docker compose run --rm caddy caddy hash-password`.
# Keep single quotes around the hash so Compose preserves its dollar signs.
DAYSMART_SITE_ADDRESS=schedule.example.com
DAYSMART_BASIC_AUTH_PASSWORD_HASH='$2a$14$replace_with_a_real_caddy_hash'

# Grafana admin login (anonymous access is read-only Viewer; this is the real
# admin account used via the login form).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# API admin endpoints (/api/admin/*). The API fails closed: if this is empty,
# every /api/admin/* request returns 403. Set it to actually use those endpoints.
ADMIN_API_KEY=your_long_random_admin_key_here

# Opt-in global context. Leave false until migration, two-year backfill, and
# curated exposure/event-rule configuration have been reviewed.
GLOBAL_CONTEXT_ENABLED=false
GLOBAL_MARKET_POLL_SECONDS=900
GLOBAL_MARKET_MAX_CONCURRENCY=2
GLOBAL_MARKET_RATE_PER_MINUTE=20
GLOBAL_MARKET_MAX_BACKOFF=14400
GLOBAL_EVENTS_POLL_SECONDS=900
GLOBAL_EVENTS_MAX_PER_RULE_DAY=20
GLOBAL_EVENTS_RATE_PER_MINUTE=10

# CORS: comma-separated browser origins allowed to call the API cross-origin.
# Usually NOT needed — the UI calls the API same-origin via Next.js's /api proxy,
# so CORS isn't triggered. Set this only if an external site/tool must call the
# API directly from a browser. Leave unset to block all cross-origin.
# CORS_ALLOW_ORIGINS=https://your-domain

# Finnhub API Key
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpaca API Keys
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
ALPACA_URL=https://data.alpaca.markets/v1beta1/news

# Reddit producer
# REDDIT_PROXY_URL: optional proxy for Reddit requests (unauthenticated .json is
# edge-blocked; a residential proxy is the stopgap until OAuth is added).
# REDDIT_POLL_INTERVAL: seconds between fetches when healthy (default 900 = 15m).
# REDDIT_MAX_BACKOFF: cap (seconds) for escalating backoff on 403/429 (default 1h).
# REDDIT_TRANSIENT_RETRY_INTERVAL: base retry for network/5xx errors (default 60s).
# REDDIT_TRANSIENT_RETRY_JITTER: maximum random retry jitter (default 15s).
# REDDIT_PROXY_URL=
REDDIT_POLL_INTERVAL=900
REDDIT_MAX_BACKOFF=3600
REDDIT_TRANSIENT_RETRY_INTERVAL=60
REDDIT_TRANSIENT_RETRY_JITTER=15

# Bluesky producer
# BLUESKY_POLL_INTERVAL: seconds between fetches when healthy (default 900 = 15m).
# BLUESKY_MAX_BACKOFF: cap (seconds) for escalating backoff on errors/rate limits (default 1h).
BLUESKY_POLL_INTERVAL=900
BLUESKY_MAX_BACKOFF=3600

# StockTwits producer
# STOCKTWITS_POLL_INTERVAL: seconds between fetches when healthy (default 900 = 15m).
# STOCKTWITS_MAX_BACKOFF: cap (seconds) for escalating backoff on errors/rate limits (default 1h).
STOCKTWITS_POLL_INTERVAL=900
STOCKTWITS_MAX_BACKOFF=3600
